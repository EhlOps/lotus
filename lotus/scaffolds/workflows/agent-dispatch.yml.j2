name: Lotus Agent Dispatch
on:
  issues:
    types: [labeled]

# NO concurrency block — we handle queuing via labels

jobs:
  dispatch:
    if: >
      startsWith(github.event.label.name, 'lotus:') &&
      github.event.label.name != 'lotus:queued' &&
      github.event.label.name != 'lotus:needs-human' &&
      github.event.label.name != 'lotus:ai-generated' &&
      github.event.label.name != 'lotus:ready'
    runs-on: ubuntu-latest
    timeout-minutes: 45

    env:
      ANTHROPIC_API_KEY: {{ "${{ secrets.ANTHROPIC_API_KEY }}" }}
      GH_TOKEN: {{ "${{ secrets.LOTUS_BOT_TOKEN }}" }}
      ISSUE_NUMBER: {{ "${{ github.event.issue.number }}" }}
      ISSUE_TITLE: {{ "${{ github.event.issue.title }}" }}
      ISSUE_BODY: {{ "${{ github.event.issue.body }}" }}

    steps:
      # ── 1. Validate secrets ──
      - name: Validate secrets
        run: |
          echo "::add-mask::${ANTHROPIC_API_KEY}"
          if [ -z "${ANTHROPIC_API_KEY}" ]; then
            echo "::error::ANTHROPIC_API_KEY not set. Run: gh secret set ANTHROPIC_API_KEY"
            exit 1
          fi
          if [ -z "${GH_TOKEN}" ]; then
            echo "::error::LOTUS_BOT_TOKEN not set. Run: gh secret set LOTUS_BOT_TOKEN"
            exit 1
          fi

      - uses: actions/checkout@v4
        with:
          token: {{ "${{ secrets.LOTUS_BOT_TOKEN }}" }}
          fetch-depth: 0  # Full history for diff comparisons

      # ── 2. Resolve issue type ──
      - name: Resolve issue type
        run: |
          LABEL="{{ "${{ github.event.label.name }}" }}"
          TYPE="${LABEL#lotus:}"

          # Validate known type
          if ! python3 -c "
          import yaml; c = yaml.safe_load(open('.lotus/config.yml'))
          assert '${TYPE}' in c['issue_types'], f'Unknown: ${TYPE}'
          "; then
            echo "Unknown issue type: ${TYPE}. Skipping."
            exit 0
          fi

          python3 -c "
          import yaml, json
          c = yaml.safe_load(open('.lotus/config.yml'))
          t = c['issue_types']['${TYPE}']
          print(f\"ISSUE_TYPE=${TYPE}\")
          print(f\"PROMPT_FILE={t['prompt']}\")
          print(f\"POST_CHECK={t['post_check']}\")
          print(f\"BRANCH_PREFIX={t['branch_prefix']}\")
          print(f\"COMMIT_PREFIX={t['commit_prefix']}\")
          " >> $GITHUB_ENV

      # ── 3. Validate issue ──
      - name: Validate issue
        run: |
          BODY_LINES=$(echo "${ISSUE_BODY}" | grep -c '\S' || true)
          if [ "$BODY_LINES" -lt 3 ]; then
            gh issue comment ${ISSUE_NUMBER} \
              --body "This issue needs more detail before Lotus can work on it. Please use a Lotus issue template and fill in all required fields."
            gh issue label ${ISSUE_NUMBER} --remove "{{ "${{ github.event.label.name }}" }}"
            exit 1
          fi

      # ── 4. Concurrency check (label-based, not Actions concurrency) ──
      - name: Check concurrency
        run: |
          MAX_CONCURRENT=$(python3 -c "
          import yaml
          c = yaml.safe_load(open('.lotus/config.yml'))
          print(c['agents'].get('max_concurrent', 2))
          ")
          ACTIVE=$(gh run list --workflow=agent-dispatch.yml --status=in_progress \
            --json databaseId --jq 'length' 2>/dev/null || echo "0")

          # Subtract 1 because THIS run counts as in_progress
          ACTIVE=$((ACTIVE - 1))

          if [ "$ACTIVE" -ge "$MAX_CONCURRENT" ]; then
            echo "Concurrency limit (${MAX_CONCURRENT}) reached. Queuing."
            gh issue label ${ISSUE_NUMBER} --add "lotus:queued"
            # Keep the type label so queue-drain knows what to re-dispatch
            exit 0
          fi

      # ── 5. Create or reset branch ──
      - name: Create branch
        run: |
          SLUG=$(echo "${ISSUE_TITLE}" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g' | cut -c1-40 | sed 's/-$//')
          BRANCH="${BRANCH_PREFIX}/${ISSUE_NUMBER}-${SLUG}"

          git fetch origin

          if git show-ref --verify --quiet "refs/remotes/origin/${BRANCH}"; then
            echo "Branch exists. Resetting to main."
            git checkout "${BRANCH}"
            git reset --hard origin/{{ repo.default_branch }}
          else
            git checkout -b "${BRANCH}"
          fi

          echo "BRANCH=${BRANCH}" >> $GITHUB_ENV

      # ── 6. Rebase check ──
      - name: Rebase on main
        run: |
          git fetch origin {{ repo.default_branch }}
          git rebase origin/{{ repo.default_branch }} || {
            gh issue comment ${ISSUE_NUMBER} \
              --body "Rebase conflict — another PR may be in flight. Requeueing."
            gh issue label ${ISSUE_NUMBER} --add "lotus:queued"
            exit 0
          }

      # ── 7. Setup environment ──
      - name: Setup environment
        uses: ./.github/actions/setup-env

      - name: Install Claude Code
        run: npm install -g @anthropic-ai/claude-code

      - name: Configure git
        run: |
          git config user.name "lotus-bot"
          git config user.email "lotus-bot@users.noreply.github.com"

      # ── 8. Auth pre-check ──
      - name: Verify Claude Code auth
        run: |
          claude --version || {
            echo "::error::Claude Code CLI not installed"
            exit 1
          }
          echo "say OK" | timeout 60 claude -p "respond with only the word OK" --max-turns 1 > /dev/null 2>&1 || {
            echo "::error::Claude Code auth failed. Check ANTHROPIC_API_KEY secret."
            exit 1
          }
          echo "✓ Claude Code authenticated"

      # ── 9. Assemble context ──
      - name: Assemble context
        run: |
          python3 -c "
          import sys, os
          sys.path.insert(0, '.')

          from pathlib import Path
          # Inline context assembly (standalone, no lotus import)
          import re, yaml

          memory_dir = Path('.lotus/memory')
          sections = []

          # Project memory
          pm = memory_dir / 'PROJECT.md'
          if pm.exists():
              sections.append(pm.read_text().strip())

          # Module memory (keyword match)
          combined = (os.environ.get('ISSUE_TITLE','') + ' ' + os.environ.get('ISSUE_BODY','')).lower()
          mods = memory_dir / 'modules'
          if mods.exists():
              for f in sorted(mods.glob('*.md')):
                  name = f.stem.lower()
                  if name in combined or f'src/{name}' in combined:
                      sections.append(f'### Module: {f.stem}\n\n{f.read_text().strip()}')

          # Decisions (last 20)
          dec = memory_dir / 'DECISIONS.md'
          if dec.exists():
              content = dec.read_text().strip()
              entries = re.split(r'\n(?=## D\d+)', content)
              if len(entries) > 21:
                  entries = entries[:1] + entries[-20:]
              sections.append('\n'.join(entries))

          Path('/tmp/memory-context.txt').write_text('\n\n---\n\n'.join(sections))
          "

          # Repo map
          find . -type f \
            -not -path './.git/*' -not -path './node_modules/*' \
            -not -path './.venv/*' -not -path './__pycache__/*' \
            -not -path './.lotus/post-checks/*' \
            | sort | head -200 > /tmp/repo-map.txt

      # ── 10. Run agent with retry loop ──
      - name: Run agent
        run: |
          MAX_RETRIES=$(python3 -c "
          import yaml; c=yaml.safe_load(open('.lotus/config.yml'))
          print(c['agents'].get('max_retries', 3))
          ")
          MAX_TURNS=$(python3 -c "
          import yaml; c=yaml.safe_load(open('.lotus/config.yml'))
          print(c['agents'].get('max_turns', 50))
          ")
          TIMEOUT=$(python3 -c "
          import yaml; c=yaml.safe_load(open('.lotus/config.yml'))
          print(c['agents'].get('timeout_minutes', 30))
          ")

          SYSTEM=$(cat .lotus/prompts/system.md)
          TYPE_PROMPT=$(cat .lotus/${PROMPT_FILE})
          MEMORY=$(cat /tmp/memory-context.txt)
          REPO_MAP=$(cat /tmp/repo-map.txt)

          ATTEMPT=0
          LAST_ERROR=""
          VAL_EXIT=1

          while [ $ATTEMPT -lt $MAX_RETRIES ]; do
            ATTEMPT=$((ATTEMPT + 1))
            echo "=== Attempt ${ATTEMPT}/${MAX_RETRIES} (${ISSUE_TYPE}) ==="

            gh issue comment ${ISSUE_NUMBER} \
              --body "Lotus agent working (attempt ${ATTEMPT}/${MAX_RETRIES}, type: \`${ISSUE_TYPE}\`)" \
              2>/dev/null || true

            # Build prompt
            PROMPT="${SYSTEM}

          ## Project Memory

          ${MEMORY}

          ## Repository Structure

          ${REPO_MAP}

          ${TYPE_PROMPT}

          ## Issue #${ISSUE_NUMBER}: ${ISSUE_TITLE}

          ${ISSUE_BODY}"

            if [ -n "${LAST_ERROR}" ]; then
              HEAL=$(cat .lotus/prompts/heal.md)
              PROMPT="${PROMPT}

          ${HEAL}

          ${LAST_ERROR}"
            fi

            # Run agent
            set +e
            timeout ${TIMEOUT}m claude \
              -p "${PROMPT}" \
              --allowedTools "Edit,Write,Bash,Read" \
              --max-turns ${MAX_TURNS} \
              2>&1 | tee /tmp/agent-output.log
            AGENT_EXIT=$?
            set -e

            if [ $AGENT_EXIT -eq 124 ]; then
              LAST_ERROR="TIMEOUT: Agent exceeded ${TIMEOUT} minute limit."
              continue
            fi

            # Revert protected paths (allow .lotus/memory/ writes)
            PROTECTED=".github/ .lotus/config.yml .lotus/prompts/ .lotus/validate.py .lotus/post-checks/ Dockerfile pyproject.toml requirements setup.cfg package.json Cargo.toml go.mod go.sum"
            for path in $PROTECTED; do
              DIRTY=$(git diff --name-only | grep "^${path}" || true)
              if [ -n "${DIRTY}" ]; then
                echo "Reverting protected: ${path}"
                git checkout -- "${path}" 2>/dev/null || git checkout HEAD -- "${path}" 2>/dev/null || true
              fi
            done

            # Validate
            set +e
            python3 .lotus/validate.py "${ISSUE_TYPE}" 2>&1 | tee /tmp/validation-output.log
            VAL_EXIT=$?
            set -e

            if [ $VAL_EXIT -eq 0 ]; then
              echo "All checks passed (attempt ${ATTEMPT})"
              break
            else
              LAST_ERROR=$(cat /tmp/validation-output.log | tail -80)
              git checkout -- . 2>/dev/null || true
            fi
          done

          if [ $VAL_EXIT -ne 0 ]; then
            gh issue comment ${ISSUE_NUMBER} \
              --body "Lotus agent failed after ${MAX_RETRIES} attempts. Last error:
          \`\`\`
          $(tail -50 /tmp/validation-output.log)
          \`\`\`" 2>/dev/null || true
            gh issue label ${ISSUE_NUMBER} --add "lotus:needs-human" --remove "{{ "${{ github.event.label.name }}" }}" 2>/dev/null || true
            exit 1
          fi

          echo "ATTEMPT=${ATTEMPT}" >> $GITHUB_ENV

      # ── 11. Commit, push, create/update PR ──
      - name: Push and create PR
        if: success()
        run: |
          git add -A

          if git diff --cached --quiet; then
            gh issue comment ${ISSUE_NUMBER} \
              --body "Agent ran but produced no changes. Issue may need clarification."
            gh issue label ${ISSUE_NUMBER} --add "lotus:needs-human" --remove "{{ "${{ github.event.label.name }}" }}"
            exit 1
          fi

          git commit -m "${COMMIT_PREFIX}(#${ISSUE_NUMBER}): ${ISSUE_TITLE}"
          git push --force-with-lease origin "${BRANCH}"

          # Check if PR already exists
          EXISTING_PR=$(gh pr view "${BRANCH}" --json number --jq '.number' 2>/dev/null || echo "")

          if [ -n "${EXISTING_PR}" ]; then
            echo "PR #${EXISTING_PR} already exists. Updated with new push."
          else
            gh pr create \
              --title "${COMMIT_PREFIX}(#${ISSUE_NUMBER}): ${ISSUE_TITLE}" \
              --body "Closes #${ISSUE_NUMBER}

          **Type:** \`${ISSUE_TYPE}\`
          **Attempts:** ${ATTEMPT}

          ---
          *Generated by Lotus. Review before merging.*" \
              --base {{ repo.default_branch }} \
              --head "${BRANCH}" \
              --label "lotus:ai-generated"

            AUTO=$(python3 -c "
            import yaml; c=yaml.safe_load(open('.lotus/config.yml'))
            print(str(c['ci'].get('auto_merge', False)).lower())
            ")
            if [ "${AUTO}" = "true" ]; then
              gh pr merge "${BRANCH}" --auto --squash --delete-branch
            fi
          fi

      # ── 12. Metrics ──
      - name: Log summary
        if: always()
        run: |
          echo "## Lotus Agent Run" >> $GITHUB_STEP_SUMMARY
          echo "- **Issue:** #${ISSUE_NUMBER}" >> $GITHUB_STEP_SUMMARY
          echo "- **Type:** ${ISSUE_TYPE:-unknown}" >> $GITHUB_STEP_SUMMARY
          echo "- **Attempts:** ${ATTEMPT:-?}" >> $GITHUB_STEP_SUMMARY
          echo "- **Result:** {{ "${{ job.status }}" }}" >> $GITHUB_STEP_SUMMARY