name: CI
on:
  pull_request:
    branches: [{{ repo.default_branch }}]
  push:
    branches: [{{ repo.default_branch }}]

concurrency:
  group: ci-{{ "${{ github.ref }}" }}
  cancel-in-progress: true

jobs:
  quality:
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
      - uses: actions/checkout@v4

      - name: Setup environment
        uses: ./.github/actions/setup-env

      - name: Format check
        run: {{ commands.format }} --check

      - name: Lint
        run: {{ commands.lint }}

      {% if commands.typecheck %}
      - name: Typecheck
        run: {{ commands.typecheck }}
      {% endif %}

      - name: Test
        run: {{ commands.test }}